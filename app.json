{
  "expo": {
    "name": "Harcama Pusulası",
    "slug": "HarcamaPusulasi",
    "version": "2.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1117",
    "icon": "./assets/icon.png",
    "scheme": "harcamapusulasi",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1117"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil fotoğrafınızı güncellemek için fotoğraf erişimi gerekiyor.",
          "cameraPermission": "Profil fotoğrafı çekmek için kamera erişimi gerekiyor."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harcamapusulasi.app"
    },
    "android": {
      "package": "com.harcamapusulasi.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1117"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    }
  }
}
