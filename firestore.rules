rules_version = '2';

// HarcamaPusulası v2 güvenlik kuralları.
//
// ÖNEMLİ: Aynı Firebase projesini eski sürüm de kullanıyor. Eski kuralları
// SİLME; aşağıdaki "v2 BAŞLANGIÇ" ile "v2 BİTİŞ" arasındaki bloğu mevcut
// kuralların içindeki  match /databases/{database}/documents { ... }
// bloğunun içine ekle.

service cloud.firestore {
  match /databases/{database}/documents {

    // ===================== v2 BAŞLANGIÇ =====================

    function signedIn() {
      return request.auth != null;
    }

    function householdData(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data;
    }

    function isMember(hid) {
      return signedIn() && request.auth.uid in householdData(hid).members;
    }

    // Kullanıcı yalnızca kendi kaydını okur ve yazar.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Davet kodları: kodu bilen giriş yapmış kişi okuyabilir, listeleyemez.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      // Kod, hane ile aynı anda ve sadece o hanenin üyesi tarafından oluşturulur.
      allow create: if signedIn()
        && request.auth.uid in getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.members
        && getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.inviteCode == code;
      allow update, delete: if false;
    }

    match /households/{hid} {
      allow read: if isMember(hid);

      // Hane kuran kişi tek üye ve kurucu olmalı.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.inviteCode is string
        && request.resource.data.inviteCode.size() == 6;

      // Üyeler hane adını değiştirebilir (üye listesine ve koda dokunmadan).
      allow update: if isMember(hid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'memberNames'])
        && request.resource.data.members == resource.data.members;

      // Davet koduyla katılma: kişi sadece KENDİNİ ekleyebilir ve aynı işlemde
      // users/{uid}.joinCode alanına hanenin davet kodunu yazmış olmalı.
      allow update: if signedIn()
        && !(request.auth.uid in resource.data.members)
        && resource.data.members.size() < 10
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.auth.uid in request.resource.data.members
        && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid])
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.joinCode == resource.data.inviteCode;

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Hanenin tüm alt verileri (işlemler, hesaplar, bütçeler...) sadece üyelere açık.
      match /{document=**} {
        allow read, write: if isMember(hid);
      }
    }

    // ===================== v2 BİTİŞ =====================
  }
}
